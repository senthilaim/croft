# dependencies
node_modules/
.pnp
.pnp.js

# build outputs
dist/
build/
.next/
out/

# env
.env
.env.local
.env.*.local

# python
automation/.venv/
automation/venv/
automation/**/__pycache__/
automation/**/*.pyc
automation/app/generated/

# runtime data generated per workspace (docker-compose + buildfarm configs, and per-workspace
# terraform working directories -- see automation/app/terraform_manager.py)
automation/runtime/

# terraform init/plan artifacts under the shared module -- never committed, and never how state is
# persisted between runs either (that's checkpointed into MongoDB, see terraform_manager.py)
automation/terraform/**/.terraform/
automation/terraform/**/.terraform.lock.hcl
automation/terraform/**/terraform.tfstate*
automation/terraform/**/*.tfvars.json

# logs
*.log
npm-debug.log*

# OS
.DS_Store

# IDE
.vscode/
.idea/
.claude/

# testing
coverage/

# TypeScript build info
*.tsbuildinfo

# downloaded sample project (generated per-workspace, has machine-local Bazel cache symlinks)
buildfarm-sample-project*/

# local sample project used for testing against Croft
bazel-monorepo/

# proto sources live under a "build" directory
!automation/protos/**/build/

# private business material (interview guides, plans) - not published with the open-source repo
business/
