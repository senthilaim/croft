PORT=4000
MONGODB_URI=mongodb://localhost:27018/croft
FRONTEND_ORIGIN=http://localhost:3000

# Phase 2 (auth)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Phase 4+ (automation service)
AUTOMATION_SERVICE_URL=http://localhost:9000
AUTOMATION_INTERNAL_TOKEN=change-me-internal-token
BES_PORT=9095
# Must match automation's BES_INGEST_SECRET -- gates the BES gRPC ingest port. See README.md.
BES_INGEST_SECRET=change-me-bes-ingest-secret

# Repo analysis (encrypts a connected repo's GitHub PAT at rest)
TOKEN_ENCRYPTION_KEY=

# Optional: Stripe billing (the Team plan upgrade). Leave blank to run Croft with billing
# disabled -- every other feature works fine either way. Fill these in with your own Stripe
# account's test-mode (or live) values to enable it: the secret key from your Dashboard, a
# recurring Price id for the Team plan, and a webhook signing secret (`stripe listen
# --print-secret` locally, or from a Dashboard-configured webhook endpoint in production).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_TEAM_PRICE_ID=

# Optional: generic OIDC single sign-on. Leave blank to run Croft with SSO disabled -- password
# auth keeps working either way. OIDC_ISSUER_URL must be an issuer whose
# {issuer}/.well-known/openid-configuration resolves (Okta, Auth0, Keycloak, Google, Authentik,
# ...). Register Croft as a confidential client with redirect URI
# {FRONTEND_ORIGIN}/api/auth/oidc/callback. OIDC_DISPLAY_NAME controls the sign-in button's label
# ("Continue with {name}") and defaults to "SSO".
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=
