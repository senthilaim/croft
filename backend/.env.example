PORT=4000
MONGODB_URI=mongodb://localhost:27018/croft
FRONTEND_ORIGIN=http://localhost:3000

# Phase 2 (auth)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Phase 4+ (automation service)
AUTOMATION_SERVICE_URL=http://localhost:9000
AUTOMATION_INTERNAL_TOKEN=change-me-internal-token
BES_PORT=9095
# Must match automation's BES_INGEST_SECRET -- gates the BES gRPC ingest port. See README.md.
BES_INGEST_SECRET=change-me-bes-ingest-secret

# Repo analysis (encrypts a connected repo's GitHub PAT at rest)
TOKEN_ENCRYPTION_KEY=
