# Copy to .env and fill in real random values (./install.sh does this for you).
#   openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
AUTOMATION_INTERNAL_TOKEN=
# Gates the BES gRPC ingest port -- shared between backend (embeds a per-workspace token derived
# from this into every generated .bazelrc) and automation (verifies it). See README.md.
BES_INGEST_SECRET=

# Optional
# CROFT_VERSION=latest
# COOKIE_SECURE=false   # set to true if you serve Croft over HTTPS
TOKEN_ENCRYPTION_KEY=

# Optional: resource limits for the sandboxed repo-analysis job (defaults shown). Raise these if
# analyzing a large repository fails with a disk/memory error or times out.
# ANALYSIS_CPU_LIMIT=2
# ANALYSIS_MEMORY_LIMIT=6g
# ANALYSIS_PIDS_LIMIT=512
# ANALYSIS_TIMEOUT_SECONDS=1200

# Optional: resource limits for the sandboxed rebuild-simulation job ("Why did this rebuild?" --
# defaults shown). Higher than the analysis limits above by default since this job runs a real
# `bazel build` (actual compilation) twice, not just `bazel query`.
# SIMULATION_CPU_LIMIT=4
# SIMULATION_MEMORY_LIMIT=8g
# SIMULATION_PIDS_LIMIT=1024
# SIMULATION_TIMEOUT_SECONDS=1800

# Optional: resource limits for the sandboxed cache-check job ("Does my remote cache actually
# work?" -- defaults shown). Same starting point as the simulation tier: worst case (a fully cold
# cache) costs about the same as a real build.
# CACHE_CHECK_CPU_LIMIT=4
# CACHE_CHECK_MEMORY_LIMIT=8g
# CACHE_CHECK_PIDS_LIMIT=1024
# CACHE_CHECK_TIMEOUT_SECONDS=1800
