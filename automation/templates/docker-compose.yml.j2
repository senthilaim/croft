name: {{ project_name }}

services:
  redis:
    image: redis:7.2.4
    command: ["redis-server", "--maxmemory", "{{ redis_memory_mb }}mb", "--maxmemory-policy", "noeviction"]
    deploy:
      resources:
        limits:
          memory: {{ redis_memory_mb }}M

  server:
    image: bazelbuild/buildfarm-server:2.17.1
    depends_on:
      - redis
    environment:
      CONFIG_PATH: /config/config.yml
    configs:
      - source: buildfarm_config
        target: /config/config.yml
    ports:
      - "{{ server_host_port }}:8980"
    deploy:
      resources:
        limits:
          cpus: "{{ server_cpu_limit }}"
          memory: {{ server_memory_mb }}M

  worker:
    image: bazelbuild/buildfarm-worker:2.17.1
    depends_on:
      - server
      - redis
    environment:
      CONFIG_PATH: /config/config.yml
    configs:
      - source: buildfarm_config
        target: /config/config.yml
    deploy:
      replicas: {{ worker_replicas }}
      resources:
        limits:
          cpus: "{{ worker_cpu_limit }}"
          memory: {{ worker_memory_mb }}M
{%- if remote_cache_enabled %}

  # L2 remote cache -- local-disk only on Docker (the "local" tier, matching the designer's
  # AWS-gating: "s3"/"both" are AWS-only). The Worker's own config.yml points at this service by
  # its compose service name, resolved automatically by Docker's internal DNS.
  bazel-remote:
    image: buchgr/bazel-remote-cache:v2.5.2
    command:
      - --dir=/data
      - --max_size={{ cache_size_gb }}
      - --grpc_address=0.0.0.0:9092
      - --http_address=0.0.0.0:9093
    volumes:
      - bazel-remote-data:/data
{%- endif %}

# Inlined rather than bind-mounted: a bind mount's path is resolved by the Docker daemon on the
# host, so it breaks when this file is generated from inside the automation container.
configs:
  buildfarm_config:
    content: |
{{ config_yml | indent(6, true) }}
{%- if remote_cache_enabled %}

volumes:
  bazel-remote-data:
{%- endif %}
